# See https://git-scm.com/docs/gitattributes for more about git attribute files.

# Mark the database schema as having been generated.
db/schema.rb linguist-generated

# Mark any vendored files as having been vendored.
vendor/* linguist-vendored
config/credentials/*.yml.enc diff=rails_credentials
config/credentials.yml.enc diff=rails_credentials

# Store text with LF and let checkout convert per platform. This currently
# depends on each clone having core.autocrlf set; stating it here makes it
# hold regardless. It matters because RuboCop's Layout/EndOfLine uses
# EnforcedStyle: native, so a blob committed with CRLF would pass on Windows
# and fail on the Linux CI runner.
* text=auto

# Executables must reach Linux with LF: a CRLF shebang is read as an
# interpreter named "ruby\r" and the script fails to start.
bin/* text eol=lf
bin/*.cmd text eol=crlf

# Never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
