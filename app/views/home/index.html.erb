<% page_title 'Dashboard' %>
<% breadcrumb ['Dashboard'] %>

<%= render 'shared/page_header',
      title: "Welcome, #{current_user.name}",
      subtitle: "Here's an overview of your content",
      actions: capture {
        safe_join([
          link_to(new_note_path, class: 'btn btn-primary') { safe_join([icon('plus'), ' New Note']) },
          link_to(new_collection_path, class: 'btn btn-secondary') { safe_join([icon('folder-plus'), ' New Collection']) }
        ])
      } %>

<section aria-labelledby="your-content-heading">
  <h2 class="visually-hidden" id="your-content-heading">Your content</h2>
  <div class="grid-3">
    <%= render 'home/stat_card', path: notes_owned_index_path, tone: 'primary',
          icon_name: 'sticky-note', value: current_user.notes.count, label: 'My Notes' %>
    <%= render 'home/stat_card', path: collections_owned_index_path, tone: 'success',
          icon_name: 'folder', value: current_user.collections.count, label: 'My Collections' %>
    <%= render 'home/stat_card', path: friends_path, tone: 'warning',
          icon_name: 'user-friends', value: current_user.friends.count, label: 'Friends' %>
  </div>
</section>

<% if current_user.admin? %>
  <div class="divider"></div>

  <section aria-labelledby="administration-heading">
    <div class="page-header">
      <div class="page-header__left">
        <h2 class="section-title" id="administration-heading">Administration</h2>
        <p class="page-subtitle">Manage all platform content</p>
      </div>
    </div>

    <div class="grid-3">
      <%= render 'home/stat_card', path: users_path, tone: 'primary',
            icon_name: 'users', value: @total_users, label: 'All Users' %>
      <%= render 'home/stat_card', path: notes_path, tone: 'success',
            icon_name: 'file-lines', value: @total_notes, label: 'All Notes' %>
      <%= render 'home/stat_card', path: collections_path, tone: 'warning',
            icon_name: 'box', value: @total_collections, label: 'All Collections' %>
    </div>
  </section>
<% end %>
