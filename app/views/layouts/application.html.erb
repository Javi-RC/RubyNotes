<!DOCTYPE html>
<html lang="en">
  <head>
    <%= render 'layouts/head' %>
  </head>

  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <% if current_user %>
      <div class="app-shell" data-controller="sidebar">
        <%= render 'layouts/sidebar' %>
        <div class="main-wrapper">
          <%= render 'layouts/topbar' %>
          <main class="page-content" id="main-content">
            <div class="flash-container" id="flash-messages">
              <%= render 'shared/flash' %>
            </div>
            <%= yield %>
          </main>
        </div>
      </div>
    <% else %>
      <div class="auth-shell">
        <div class="flash-container" id="flash-messages">
          <%= render 'shared/flash' %>
        </div>
        <main class="auth-shell__content" id="main-content">
          <%= yield %>
        </main>
      </div>
    <% end %>
  </body>
</html>
