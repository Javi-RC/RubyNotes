<nav class="navbar navbar-expand-lg navbar-light bg-color" style="padding: 20px 0;">
  <div class="container">
    <a class="navbar-brand nav-text" href="<%= home_path %>"><i class="fas fa-home"></i> Home Page!</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav me-auto">
        <li class="nav-item nav-text">
          <%= link_to new_note_path, class: 'nav-link btn btn-outline-success' do %>
            <i class="fas fa-plus"></i> New Note
          <% end %>
        </li>
      </ul>
      <ul class="navbar-nav ms-auto nav-text">
        <% if current_user %>
          <li class="nav-item">
            <a class="nav-link" href="<%= show_profile_path(current_user) %>">
              <i class="fas fa-user"></i> <%= current_user.name %>
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="<%= notifications_path %>">
              <i class="fa-regular fa-bell"></i>
              <% pending = Notification.where(receiver_id: current_user.id, status: "pending").count %>
              <% if pending > 0 %>
                <span class="badge bg-danger"><%= pending %></span>
              <% end %>
            </a>
          </li>
          <li class="nav-item">
            <%= form_tag logout_path, method: :delete do %>
              <%= button_tag type: 'submit', class: 'nav-link btn btn-outline-dark' do %>
                <i class="fa-solid fa-right-from-bracket"></i> LogOut
              <% end %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>
