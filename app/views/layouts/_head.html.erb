<title><%= content_for?(:page_title) ? "#{yield(:page_title)} — RubyNotes" : 'RubyNotes' %></title>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="description" content="<%= content_for?(:page_description) ? yield(:page_description) : 'RubyNotes - Organize, share, and collaborate on notes' %>">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📝</text></svg>">
<%= csrf_meta_tags %>
<%= csp_meta_tag %>

<%# Runs before the stylesheet so the stored theme is applied on the first
    paint. Kept inline and tiny on purpose; theme_controller.js owns the rest. %>
<%# nonce: true is required — the CSP sets a nonce for script-src, which makes
    browsers ignore the 'unsafe-inline' fallback. %>
<%= javascript_tag nonce: true do %>
  (function () {
    try {
      var t = localStorage.getItem('rubynotes-theme')
      if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t)
    } catch (e) {}
  })()
<% end %>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer">

<%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
<%= javascript_importmap_tags %>

<%= yield :head if content_for?(:head) %>
