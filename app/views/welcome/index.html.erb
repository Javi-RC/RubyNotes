<% page_title 'Organize and Share Your Notes' %>
<% content_for :page_description, 'RubyNotes helps you organize, share, and collaborate on notes with friends.' %>

<nav class="landing-nav">
  <div class="landing-nav__inner">
    <%= link_to root_path, class: 'landing-nav__brand' do %>
      <%= icon 'sticky-note' %>
      RubyNotes
    <% end %>
    <div class="landing-nav__actions">
      <%= link_to 'Sign in', new_session_path, class: 'btn btn-ghost' %>
      <%= link_to 'Get started', new_user_path, class: 'btn btn-primary' %>
    </div>
  </div>
</nav>

<main id="main-content">
  <section class="landing-hero">
    <h1 class="landing-hero__title">
      Organize your notes.<br>
      <span>Share them with friends.</span>
    </h1>
    <p class="landing-hero__subtitle">
      RubyNotes helps you create, organize, and collaborate on notes. Keep your thoughts structured and share them with the people who matter.
    </p>
    <div class="landing-hero__actions">
      <%= link_to new_user_path, class: 'btn btn-primary btn-lg' do %>
        <%= icon 'rocket' %> Get Started Free
      <% end %>
      <%= link_to 'Sign in', new_session_path, class: 'btn btn-secondary btn-lg' %>
    </div>
  </section>

  <section class="landing-features">
    <h2 class="visually-hidden">Features</h2>
    <div class="grid-3">
      <div class="landing-feature-card">
        <div class="stat-card__icon stat-card__icon--primary">
          <%= icon 'sticky-note' %>
        </div>
        <div class="landing-feature-card__content">
          <h3 class="landing-feature-card__title">Rich Notes</h3>
          <p class="landing-feature-card__description">Create notes with rich text formatting, images, and lists.</p>
        </div>
      </div>

      <div class="landing-feature-card">
        <div class="stat-card__icon stat-card__icon--success">
          <%= icon 'folder' %>
        </div>
        <div class="landing-feature-card__content">
          <h3 class="landing-feature-card__title">Collections</h3>
          <p class="landing-feature-card__description">Group related notes into collections for easy access.</p>
        </div>
      </div>

      <div class="landing-feature-card">
        <div class="stat-card__icon stat-card__icon--warning">
          <%= icon 'share-nodes' %>
        </div>
        <div class="landing-feature-card__content">
          <h3 class="landing-feature-card__title">Share &amp; Collaborate</h3>
          <p class="landing-feature-card__description">Share notes and collections with friends and colleagues.</p>
        </div>
      </div>
    </div>
  </section>
</main>

<footer class="landing-footer">
  <div class="landing-footer__inner">
    <span class="landing-footer__brand">RubyNotes</span>
    <div class="landing-footer__credits">
      Developed by
      <a href="mailto:javier.Rodriguez46@alu.uclm.es">Javier Rodriguez</a>
    </div>
  </div>
</footer>
