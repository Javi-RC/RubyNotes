<% page_title 'Sign in' %>

<div class="auth-card">
  <div class="auth-card__brand">
    <%= icon 'sticky-note' %>
    <h1>Welcome back</h1>
    <p>Sign in to your account</p>
  </div>

  <%= form_with url: sessions_path, method: :post do |form| %>
    <div class="form-group">
      <%= form.label :name, 'Username', class: 'form-label' %>
      <%= form.text_field :name, class: 'form-control', required: true, autofocus: true,
            autocomplete: 'username' %>
    </div>

    <div class="form-group">
      <%= form.label :password, 'Password', class: 'form-label' %>
      <%= form.password_field :password, class: 'form-control', required: true,
            autocomplete: 'current-password' %>
    </div>

    <%= form.submit 'Sign in', class: 'btn btn-primary btn-lg' %>
  <% end %>

  <div class="auth-card__footer">
    Don't have an account? <%= link_to 'Create one', new_user_path %>
  </div>

  <div class="auth-card__home-link">
    <%= link_to root_path do %>
      <%= icon 'arrow-left' %> Back to home
    <% end %>
  </div>
</div>
