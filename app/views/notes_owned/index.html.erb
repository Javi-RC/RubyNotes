<% page_title 'My Notes' %>
<% breadcrumb ['My Notes'] %>

<%= render 'shared/page_header',
      title: 'My Notes',
      subtitle: 'Notes you own and notes shared with you',
      actions: capture {
        link_to new_note_path, class: 'btn btn-primary' do
          safe_join([icon('plus'), ' New Note'])
        end
      } %>

<%= render 'shared/tabs', label: 'Note ownership', current: @tab, tabs: [
      { key: 'owned', label: 'My Notes', icon: 'user', count: @owned_count },
      { key: 'shared', label: 'Shared with Me', icon: 'share-nodes', count: @shared_count }
    ] %>

<div class="search-wrapper">
  <%= render 'shared/search_input',
        placeholder: 'Search notes by title...',
        carry: { tab: @tab } %>
</div>

<% if @notes.any? %>
  <div class="grid-cards">
    <% @notes.each do |note| %>
      <%= render 'notes/note_card', note: note, owned: @tab == 'owned' %>
    <% end %>
  </div>

  <%= render 'shared/pagination' %>
<% elsif searching? %>
  <%= render 'shared/empty_state',
        icon: 'magnifying-glass', icon_style: :solid,
        title: "No notes match “#{search_query}”",
        description: 'Try a different search term.',
        action_path: notes_owned_index_path(tab: @tab),
        action_icon: 'times',
        action_label: 'Clear search' %>
<% elsif @tab == 'shared' %>
  <%= render 'shared/empty_state',
        icon: 'share-nodes', icon_style: :solid,
        title: 'No shared notes',
        description: 'When someone shares a note with you, it will appear here.' %>
<% else %>
  <%= render 'shared/empty_state',
        icon: 'sticky-note',
        title: 'No notes yet',
        description: 'Create your first note to get started.',
        action_path: new_note_path,
        action_label: 'Create Note' %>
<% end %>
