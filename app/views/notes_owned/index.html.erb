<div class="container mt-5">
  <hr class="border border-dark" style="height: 8px; background-color: black; margin-bottom: 3rem">
  

  <form class="d-flex mb-2">
    <input id="note-search-input" class="form-control me-2" type="search" placeholder="Search by title" aria-label="Search">
  </form>

  <div class="row">
    <% if @notes.any? || @sharednotes.any? %>
      <% @notes.each do |note| %>
        <div class="col-md-4 mb-4">
          <div class="card bg-color-card">
            <div class="card-body">
              <h5 class="card-title"><%= note.title %></h5>
              <hr class="my-4 border border-dark">
              <div class="card-text note-content">
                <% if note.content.present? %>
                  <div style="max-width: 500px; max-height: 500px; overflow: auto;">
                    <%= raw(note.content.html_safe) %>
                  </div>
                <% end %>
              </div>
            </div>
            <div class="card-footer d-flex align-items-center gap-2">
              <%= link_to note, class: 'btn btn-primary mr-2' do %>
                <i class="fas fa-eye"></i> Show
              <% end %>
              <%= link_to edit_note_path(note), class: 'btn btn-info', title: 'Share' do %>
                <i class="fas fa-share"></i> Share
              <% end %>
              <div class="dropdown">
                <button class="btn btn-secondary dropdown-toggle" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                  <i class="fas fa-ellipsis-v"></i>
                </button>
                <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                  <%= link_to edit_note_path(note), class: 'dropdown-item' do %>
                    <i class="fas fa-edit"></i> Edit
                  <% end %>
                  <%= link_to edit_note_path(note), class: 'dropdown-item' do %>
                    <i class="fas fa-plus"></i> Add to Collection
                  <% end %>
                  <%= button_to note_path(note), method: :delete, class: 'dropdown-item', data: { confirm: 'Are you sure?' } do %>
                    <i class="fas fa-trash-alt"></i> Delete
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <% @sharednotes.each do |note| %>
        <div class="col-md-4 mb-4">
          <div class="card bg-color-card">
            <div class="card-body">
              <h5 class="card-title"><%= note.title %></h5>
              <hr class="my-4 border border-dark">
              <div class="card-text note-content">
                <% if note.content.present? %>
                  <div style="max-width: 500px; max-height: 500px; overflow: auto;">
                    <%= raw(note.content.html_safe) %>
                  </div>
                <% end %>
              </div>
            </div>
            <div class="card-footer d-flex align-items-center gap-2">
              <%= link_to note, class: 'btn btn-primary mr-2' do %>
                <i class="fas fa-eye"></i> Show
              <% end %>
              <div class="dropdown">
                <button class="btn btn-secondary dropdown-toggle" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                  <i class="fas fa-ellipsis-v"></i>
                </button>
                <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                  <%= link_to edit_note_path(note), class: 'dropdown-item' do %>
                    <i class="fas fa-edit"></i> Edit
                  <% end %>
                  <%= link_to edit_note_path(note), class: 'dropdown-item' do %>
                    <i class="fas fa-plus"></i> Add to Collection
                  <% end %>
                  <%= button_to note_path(note), method: :delete, class: 'dropdown-item', data: { confirm: 'Are you sure?' } do %>
                    <i class="fas fa-trash-alt"></i> Delete
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <% else %>
    <div class="container text-center mt-5">
      <p style="font-size: 48px;"><i class="far fa-frown"></i> You don't have any notes! <i class="far fa-frown"></i></p>
      
      <%= link_to new_note_path, class: 'btn btn-success btn-lg' do %>
        <i class="fas fa-pencil-alt"></i> Start now!
      <% end %>
    </div>
  <% end %>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('note-search-input');
    const notesList = document.querySelector('.row');

    searchInput.addEventListener('input', function() {
      const searchTerm = this.value.trim().toLowerCase();

      Array.from(notesList.children).forEach(function(note) {
        const noteTitle = note.querySelector('.card-title').textContent.trim().toLowerCase();
        if (noteTitle.includes(searchTerm)) {
          note.style.display = 'block';
        } else {
          note.style.display = 'none';
        }
      });
    });
  });
</script>
