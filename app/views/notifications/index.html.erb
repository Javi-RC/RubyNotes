<div class="container">
  <h1 class="mt-4 mb-4">Notifications <i class="fas fa-envelope-square"></i></h1>
  <hr class="border border-dark" style="height: 8px; background-color: black; margin-bottom: 3rem">

  <h4>All Notifications</h4>
<ul class="list-group">
  <li class="list-group-item" style="max-height: 800px; overflow: auto;">
    <% @notifications.each do |notification| %>
      <% case notification.status %>
        <% when "pending" %>
          <div class="alert alert-primary d-flex align-items-center justify-content-between pending" role="alert">
        <% when "accepted" %>
          <div class="alert alert-success d-flex align-items-center justify-content-between accepted" role="alert">
        <% when "denied" %>
          <div class="alert alert-primary alert-success d-flex align-items-center justify-content-between denied" role="alert">
        <% when "read" %>
          <div class="alert alert-primary alert-success d-flex align-items-center justify-content-between read" role="alert">
        <% when "unread" %>
          <div class="alert alert-primary alert-success d-flex align-items-center justify-content-between unread" role="alert">
        <% else %>
          <div class="alert alert-primary alert-success d-flex align-items-center justify-content-between pending" role="alert">
      <% end %>
      <div>
        <% case notification.type %>
          <% when "friend_request" %>
            <i class="fas fa-user-friends me-3"></i>
          <% when "friendship_response" %>
            <i class="fas fa-user-friends me-3"></i>
          <% when "note_share" %>
            <i class="fas fa-sticky-note me-3"></i>
          <% when "note_accepted" %>
            <i class="fas fa-sticky-note me-3"></i>
          <% when "collection_share" %>
            <i class="fas fa-folder-open me-3"></i>
          <% when "collection_accepted" %>
            <i class="fas fa-folder-open me-3"></i>
          <% else %>
            <i class="fas fa-bell me-3"></i>
        <% end %>
        <%= notification.message %>
      </div>
        <div>
          <% case notification.status %>
            <% when "pending" %>
              <i class="fas fa-hourglass-half me-2"></i>
            <% when "accepted" %>
              <i class="fas fa-check-circle me-2"></i>
            <% when "denied" %>
              <i class="fas fa-times-circle me-2"></i>
            <% when "read" %>
              <i class="fas fa-eye me-2"></i>
            <% when "unread" %>
              <i class="fas fa-envelope-open-text me-2"></i>
          <% end %>
        </div>
        <div>
          <% if notification.status === "pending" %>
            <%= link_to accept_notification_path(notification), method: :post, class: "btn btn-success me-1" do %>
              <i class="fas fa-check"></i> Accept
            <% end %>
            <%= link_to deny_notification_path(notification), method: :post, class: "btn btn-danger me-1" do %>
              <i class="fas fa-times"></i> Deny
            <% end %>
          <% end %>
          <% if notification.status != "pending" %>
            <%= button_to delete_notification_path(notification), method: :delete, data: { confirm: 'Are you sure?' }, class: "btn btn-danger" do %>
              <i class="fas fa-trash-alt"></i> Delete
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </li>
</ul>
</div>
