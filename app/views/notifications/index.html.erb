<% page_title 'Notifications' %>
<% breadcrumb ['Notifications'] %>

<%= render 'shared/page_header',
      title: 'Notifications',
      subtitle: 'Stay updated on your activity' %>

<% if @notifications.any? %>
  <div class="card card--detail">
    <ul class="card-body card-body--flush list">
      <% @notifications.each do |notification| %>
        <%= render 'notifications/notification_item', notification: notification %>
      <% end %>
    </ul>
  </div>

  <%= render 'shared/pagination' %>
<% else %>
  <%= render 'shared/empty_state',
        icon: 'bell',
        title: 'No notifications',
        description: "You're all caught up. Friend requests, shares and responses will appear here." %>
<% end %>
