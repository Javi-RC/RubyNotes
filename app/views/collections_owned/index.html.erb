<div class="container mt-5">
  <hr class="border border-dark" style="height: 8px; background-color: black">
  <form class="d-flex mb-2">
    <input id="collection-search-input" class="form-control me-2" type="search" placeholder="Search by title" aria-label="Search">
  </form>
  <div class="row">
    <% if @collections.any? %>
      <% @collections.each do |collection| %>
        <div class="col-md-4 mb-4 collection">
          <div class="card bg-color-card">
            <div class="card-body">
              <h5 class="card-title"><%= collection.title %></h5>
              <hr class="my-4 border border-dark">
              <div class="card-text collection-notes">
                <% if collection.notes.any? %>
                  <% collection.notes.each do |note| %>
                    <p><%= truncate(raw(note.title), length: 50) %></p>
                  <% end %>
                <% else %>
                  <p>No notes in this collection yet.</p>
                <% end %>
              </div>
            </div>
            <div class="card-footer d-flex align-items-center gap-2">
              <%= link_to collection, class: 'btn btn-primary mr-2' do %>
                <i class="fas fa-eye"></i> Show
              <% end %>
              <%= link_to edit_collection_path(collection), class: 'btn btn-secondary' do %>
                <i class="fas fa-edit"></i> Edit
              <% end %>
              <%= link_to edit_collection_path(collection), class: 'btn btn-primary mr-2' do %>
                <i class="fa-solid fa-share-nodes"></i> Share
              <% end %>
              <%= button_to collection_path(collection), method: :delete, class: 'btn btn-danger', data: { confirm: 'Are you sure?' } do %>
                <i class="fas fa-trash-alt"></i> Delete
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
    
    <% if @sharedcollections.any? %>
      <% @sharedcollections.each do |collection| %>
        <div class="col-md-4 mb-4 collection">
          <div class="card bg-color-card">
            <div class="card-body">
              <h5 class="card-title"><%= collection.title %></h5>
              <hr class="my-4 border border-dark">
              <div class="card-text collection-notes">
                <% if collection.notes.any? %>
                  <% collection.notes.each do |note| %>
                    <p><%= truncate(raw(note.title), length: 50) %></p>
                  <% end %>
                <% else %>
                  <p>No notes in this collection yet.</p>
                <% end %>
              </div>
            </div>
            <div class="card-footer d-flex align-items-center gap-2">
              <%= link_to collection, class: 'btn btn-primary mr-2' do %>
                <i class="fas fa-eye"></i> Show
              <% end %>
              <%= link_to edit_collection_path(collection), class: 'btn btn-secondary' do %>
                <i class="fas fa-edit"></i> Edit
              <% end %>
              <%= button_to collection_path(collection), method: :delete, class: 'btn btn-danger', data: { confirm: 'Are you sure?' } do %>
                <i class="fas fa-trash-alt"></i> Delete
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>

<% if !@collections.any? && !@sharedcollections.any? %>
  <div class="container text-center mt-5">
    <p style="font-size: 48px;"><i class="far fa-frown"></i> You don't have any collections! <i class="far fa-frown"></i></p>
    <hr class="border border-dark mt-5" style="height: 8px; background-color: black; margin-bottom: 3rem">
    <%= link_to new_collection_path, class: 'btn btn-success btn-lg' do %>
      <i class="fas fa-box"></i> Create your first collection!
    <% end %>
  </div>
<% end %>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('collection-search-input');
    const collections = document.querySelectorAll('.collection');

    searchInput.addEventListener('input', function() {
      const searchTerm = this.value.trim().toLowerCase();

      collections.forEach(function(collection) {
        const collectionTitle = collection.querySelector('.card-title').textContent.trim().toLowerCase();
        if (collectionTitle.includes(searchTerm)) {
          collection.style.display = 'block';
        } else {
          collection.style.display = 'none';
        }
      });
    });
  });
</script>
