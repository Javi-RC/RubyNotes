<% page_title 'My Collections' %>
<% breadcrumb ['My Collections'] %>

<%= render 'shared/page_header',
      title: 'My Collections',
      subtitle: 'Organize your notes into collections',
      actions: capture {
        link_to new_collection_path, class: 'btn btn-primary' do
          safe_join([icon('plus'), ' New Collection'])
        end
      } %>

<%= render 'shared/tabs', label: 'Collection ownership', current: @tab, tabs: [
      { key: 'owned', label: 'My Collections', icon: 'user', count: @owned_count },
      { key: 'shared', label: 'Shared with Me', icon: 'share-nodes', count: @shared_count }
    ] %>

<div class="search-wrapper">
  <%= render 'shared/search_input',
        placeholder: 'Search collections by title...',
        carry: { tab: @tab } %>
</div>

<% if @collections.any? %>
  <div class="grid-cards">
    <% @collections.each do |collection| %>
      <%= render 'collections/collection_card', collection: collection %>
    <% end %>
  </div>

  <%= render 'shared/pagination' %>
<% elsif searching? %>
  <%= render 'shared/empty_state',
        icon: 'magnifying-glass', icon_style: :solid,
        title: "No collections match “#{search_query}”",
        description: 'Try a different search term.',
        action_path: collections_owned_index_path(tab: @tab),
        action_icon: 'times',
        action_label: 'Clear search' %>
<% elsif @tab == 'shared' %>
  <%= render 'shared/empty_state',
        icon: 'share-nodes', icon_style: :solid,
        title: 'No shared collections',
        description: 'When someone shares a collection with you, it will appear here.' %>
<% else %>
  <%= render 'shared/empty_state',
        icon: 'folder',
        title: 'No collections yet',
        description: 'Create a collection to organize your notes.',
        action_path: new_collection_path,
        action_icon: 'folder-plus',
        action_label: 'Create Collection' %>
<% end %>
