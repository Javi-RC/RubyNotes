<% page_title 'All Collections' %>
<% breadcrumb ['Administration'], ['All Collections'] %>

<%= render 'shared/page_header',
      title: 'All Collections',
      subtitle: 'Manage all collections across the platform',
      actions: capture {
        link_to new_collection_path, class: 'btn btn-primary' do
          safe_join([icon('plus'), ' New Collection'])
        end
      } %>

<div class="search-wrapper">
  <%= render 'shared/search_input', placeholder: 'Search collections by title...' %>
</div>

<% if @collections.any? %>
  <div class="grid-cards">
    <% @collections.each do |collection| %>
      <%= render 'collections/collection_card', collection: collection %>
    <% end %>
  </div>

  <%= render 'shared/pagination' %>
<% elsif searching? %>
  <%= render 'shared/empty_state',
        icon: 'magnifying-glass', icon_style: :solid,
        title: "No collections match “#{search_query}”",
        description: 'Try a different search term.',
        action_path: collections_path,
        action_icon: 'times',
        action_label: 'Clear search' %>
<% else %>
  <%= render 'shared/empty_state',
        icon: 'folder',
        title: 'No collections found',
        description: 'No collections have been created yet.' %>
<% end %>
