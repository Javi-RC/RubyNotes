<% page_title 'Create Collection' %>
<% breadcrumb ['My Collections', collections_owned_index_path], ['New Collection'] %>

<%= render 'shared/back_link', label: 'Back to collections', back_path: collections_owned_index_path %>

<%= render layout: 'shared/form_card', locals: { title: 'New Collection', object: @collection } do %>
  <%= form_with(model: @collection, local: true) do |form| %>
    <div class="form-group">
      <%= form.label :title, 'Title', class: 'form-label' %>
      <%= form.text_field :title, class: 'form-control', required: true, autofocus: true,
            'aria-describedby': 'collection-title-hint' %>
      <p class="form-hint" id="collection-title-hint">For example “Recipes” or “Q3 planning”.</p>
    </div>

    <% if @notes.any? %>
      <fieldset class="form-section">
        <legend class="form-section__title">Add notes</legend>
        <% @notes.each do |note| %>
          <div class="form-check">
            <%= check_box_tag 'collection[note_ids][]', note.id, false,
                  class: 'form-check-input', id: "collection_note_#{note.id}" %>
            <%= label_tag "collection_note_#{note.id}", note.title, class: 'form-check-label' %>
          </div>
        <% end %>
      </fieldset>
    <% else %>
      <div class="alert alert-primary" role="status">
        <%= icon 'info-circle' %>
        <div>
          You don't have any notes yet. <%= link_to 'Create a note first', new_note_path %> — you can also
          create the collection now and add notes to it later.
        </div>
      </div>
    <% end %>

    <div class="form-actions">
      <%= form.submit 'Create Collection', class: 'btn btn-primary btn-lg' %>
      <%= link_to 'Cancel', collections_owned_index_path, class: 'btn btn-ghost' %>
    </div>
  <% end %>
<% end %>
