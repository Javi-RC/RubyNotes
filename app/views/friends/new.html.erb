<nav class="navbar navbar-expand-lg navbar-light bg-color" style="padding: 20px 0;">
  <div class="container">
    <a class="navbar-brand nav-text" href="<%= friends_path %>">Friend List!</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
    <% if User.find_by(name: session[:user]).role === 'admin' %>
      <ul class="navbar-nav me-auto"> 
        <li class="nav-item nav-text">
           <li class="nav-item nav-text">
          <%= link_to new_user_path, class: 'nav-link btn btn-outline-success' do %>
            <i class="fas fa-plus"></i> New User
          <% end %>
        </li>
        </li>
      </ul>
    <% end %>
      <ul class="navbar-nav ms-auto nav-text"> 
        <%= form_tag '/logout', method: :delete do %>
          <%= button_tag type: 'submit', class: 'nav-link btn btn-outline-dark' do %>
            <i class="fa-solid fa-right-from-bracket"></i> LogOut
          <% end %>
        <% end %>
      </ul>
    </div>
  </div>
</nav>

<% if @users.any? %>
  <div class="container mt-5">
    <hr class="border border-dark" style="height: 8px; background-color: black; margin-bottom: 3rem">
    <form class="d-flex mb-2">
      <input id="user-search-input" class="form-control me-2" type="search" placeholder="Search by name" aria-label="Search">
    </form>
    <div class="row">
      <% @users.each do |user| %>
        <div class="col-md-4 mb-4 user">
          <div class="card bg-color-card">
            <div class="card-body">
              <h5 class="card-title"><%= user.name %></h5>
            </div>
            <div class="card-footer d-flex align-items-center gap-2">
               <%= link_to 'Add Friend', send_request_path(user), class: 'btn btn-success' %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% else %>
  <div class="container text-center mt-5">
    <p style="font-size: 48px;"><i class="far fa-frown"></i> There is no registered user <i class="far fa-frown"></i></p>
  </div>
<% end %>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('user-search-input');
    const users = document.querySelectorAll('.user');

    searchInput.addEventListener('input', function() {
      const searchTerm = this.value.trim().toLowerCase();

      users.forEach(function(user) {
        const userName = user.querySelector('.card-title').textContent.trim().toLowerCase();
        if (userName.includes(searchTerm)) {
          user.style.display = 'block';
        } else {
          user.style.display = 'none';
        }
      });
    });
  });
</script>
