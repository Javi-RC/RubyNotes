<% page_title 'Add Friend' %>
<% breadcrumb ['Friends', friends_path], ['Add Friend'] %>

<%= render 'shared/back_link', label: 'Back to friends', back_path: friends_path %>

<%= render 'shared/page_header',
      title: 'Find People',
      subtitle: 'Send friend requests to other users' %>

<div class="search-wrapper">
  <%= render 'shared/search_input', placeholder: 'Search by username...' %>
</div>

<% if @users.any? %>
  <div class="grid-cards">
    <% @users.each do |user| %>
      <%= render 'friends/friend_card', friend: user, mode: :candidate %>
    <% end %>
  </div>

  <%= render 'shared/pagination' %>
<% elsif searching? %>
  <%= render 'shared/empty_state',
        icon: 'magnifying-glass', icon_style: :solid,
        title: "No users match “#{search_query}”",
        description: 'Try a different username.',
        action_path: new_friend_path,
        action_icon: 'times',
        action_label: 'Clear search' %>
<% else %>
  <%= render 'shared/empty_state',
        icon: 'users', icon_style: :solid,
        title: 'No users available',
        description: 'There are no other users to add as friends.' %>
<% end %>
