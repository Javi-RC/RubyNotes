<% page_title 'My Friends' %>
<% breadcrumb ['Friends'] %>

<%= render 'shared/page_header',
      title: 'My Friends',
      subtitle: "People you've connected with",
      actions: capture {
        link_to new_friend_path, class: 'btn btn-primary' do
          safe_join([icon('user-plus'), ' Add Friend'])
        end
      } %>

<div class="search-wrapper">
  <%= render 'shared/search_input', placeholder: 'Search friends by name...' %>
</div>

<% if @friends.any? %>
  <div class="grid-cards">
    <% @friends.each do |friend| %>
      <%= render 'friends/friend_card', friend: friend %>
    <% end %>
  </div>

  <%= render 'shared/pagination' %>
<% elsif searching? %>
  <%= render 'shared/empty_state',
        icon: 'magnifying-glass', icon_style: :solid,
        title: "No friends match “#{search_query}”",
        description: 'Try a different name.',
        action_path: friends_path,
        action_icon: 'times',
        action_label: 'Clear search' %>
<% else %>
  <%= render 'shared/empty_state',
        icon: 'user-friends', icon_style: :solid,
        title: 'No friends yet',
        description: 'Add friends to share notes and collections with them.',
        action_path: new_friend_path,
        action_icon: 'user-plus',
        action_label: 'Add Friend' %>
<% end %>
