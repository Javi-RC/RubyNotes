<%= render 'layouts/navbar' %>

<% if @friends.any? %>
  <div class="container mt-5">
    <hr class="border border-dark" style="height: 8px; background-color: black; margin-bottom: 3rem">
    <div data-controller="search" data-search-match-on-value=".card-title">
      <form class="d-flex mb-2">
        <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search" data-search-target="input" data-action="input->search#filter">
      </form>
      <div class="row" data-search-target="list">
        <% @friends.each do |friend| %>
          <div class="col-md-4 mb-4 friend" data-search-target="item">
            <div class="card bg-color-card">
              <div class="card-body">
                <h5 class="card-title"><%= sanitize(friend.name) %></h5>
              </div>
              <div class="card-footer d-flex align-items-center gap-2">
                <%= link_to 'See Friend', see_friend_path(friend), class: 'btn btn-success mr-2' %>
                <%= button_to 'Remove Friend', remove_friend_path(friend), method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-danger', remote: true %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% else %>
  <div class="container text-center mt-5">
    <p style="font-size: 48px;"><i class="far fa-frown"></i> You have no friends <i class="far fa-frown"></i></p>
  </div>
<% end %>
