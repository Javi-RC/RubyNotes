<% page_title @note.title %>
<% breadcrumb ['My Notes', notes_owned_index_path], [@note.title] %>

<%= render 'shared/back_link', label: 'Back to notes', back_path: notes_owned_index_path %>

<%= render layout: 'shared/detail_card', locals: {
      title: @note.title,
      meta: capture {
        safe_join([
          content_tag(:span, safe_join([icon('user'), " #{@note.user.name}"]), class: 'badge badge-neutral'),
          content_tag(:span, safe_join([icon('clock', style: :regular), " #{time_ago(@note)}"]), class: 'badge badge-neutral')
        ].compact)
      },
      actions: (note_manageable?(@note) ? capture {
        safe_join([
          link_to(edit_note_path(@note), class: 'btn btn-sm btn-secondary') { safe_join([icon('pen'), ' Edit']) },
          button_to(note_path(@note), method: :delete, class: 'btn btn-sm btn-danger',
                    form: { data: { turbo_confirm: "Delete “#{@note.title}”? This cannot be undone." } }) {
            safe_join([icon('trash-can', style: :regular), ' Delete'])
          }
        ])
      } : nil)
    } do %>

  <% if @note.content.present? %>
    <div class="rich-content"><%= sanitize(@note.content) %></div>
  <% else %>
    <%= render 'shared/empty_state', variant: :inline,
          icon: 'file-lines', title: 'This note has no content yet.' %>
  <% end %>

  <% if @note.collections.any? %>
    <div class="divider"></div>
    <h3 class="section-heading">Collections</h3>
    <div class="content-card__tags">
      <% @note.collections.each do |collection| %>
        <%= link_to collection_path(collection), class: 'badge badge-primary' do %>
          <%= icon 'folder' %> <%= collection.title %>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>
