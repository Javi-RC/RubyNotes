<%= render 'layouts/navbar' %>

<div class="container mt-5">
  <div class="card shadow-sm">
    <div class="card-header">
      <h5 class="card-title mb-0">Note Details</h5>
    </div>
    <div class="card-body">
      <div class="field">
        <h5>Title: <%= @note.title %></h5>

        <br>
        <div class="card-text">
          <% if @note.content.present? %>
            <%= sanitize(@note.content) %>
          <% end %>
        </div>
        <br>
        <% if @note.collections.any? %>
          <h6>Collections:</h6>
          <ul>
            <% @note.collections.each do |collection| %>
              <li><%= link_to sanitize(collection.title), collection_path(collection) %></li>
            <% end %>
          </ul>
        <% else %>
          <p>This note is not in a collection yet!</p>
        <% end %>
      </div>
    </div>

    <div class="card-footer d-flex align-items-center gap-2">
      <%= link_to (request.referer || root_path), class: 'back-button my-2' do %>
        <i class="fas fa-arrow-left"></i> Back
      <% end %>
      <%= link_to edit_note_path(@note), class: 'btn btn-secondary' do %>
        <i class="fas fa-edit"></i> Edit
      <% end %>
      <%= link_to edit_note_path(@note), class: 'btn btn-primary mr-2' do %>
        <i class="fas fa-plus"></i> Add to Collection
      <% end %>
      <%= button_to note_path(@note), method: :delete, class: 'btn btn-danger', data: { confirm: 'Are you sure?' } do %>
        <i class="fas fa-trash-alt"></i> Delete
      <% end %>
    </div>
  </div>
</div>
