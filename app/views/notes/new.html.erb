<% page_title 'Create Note' %>
<% breadcrumb ['My Notes', notes_owned_index_path], ['New Note'] %>
<%= render 'shared/tinymce_assets' %>

<%= render 'shared/back_link', label: 'Back to notes', back_path: notes_owned_index_path %>

<%= render layout: 'shared/form_card', locals: { title: 'New Note', object: @note } do %>
  <%= form_with(model: @note, local: true) do |form| %>
    <div class="form-group">
      <%= form.label :title, 'Title', class: 'form-label' %>
      <%= form.text_field :title, class: 'form-control', required: true, autofocus: true,
            'aria-describedby': 'note-title-hint' %>
      <p class="form-hint" id="note-title-hint">A short name you'll recognise in your list of notes.</p>
    </div>

    <div class="form-group">
      <%= form.label :content, 'Content', class: 'form-label' %>
      <%= form.text_area :content, class: 'form-control tinymce', id: 'note_content',
            data: { controller: 'tinymce' } %>
    </div>

    <% if @collections.any? %>
      <fieldset class="form-section">
        <legend class="form-section__title">Add to collections</legend>
        <% @collections.each do |collection| %>
          <div class="form-check">
            <%= check_box_tag 'note[collection_ids][]', collection.id, false,
                  class: 'form-check-input', id: "note_collection_#{collection.id}" %>
            <%= label_tag "note_collection_#{collection.id}", collection.title, class: 'form-check-label' %>
          </div>
        <% end %>
      </fieldset>
    <% end %>

    <div class="form-actions">
      <%= form.submit 'Create Note', class: 'btn btn-primary btn-lg' %>
      <%= link_to 'Cancel', notes_owned_index_path, class: 'btn btn-ghost' %>
    </div>
  <% end %>
<% end %>
