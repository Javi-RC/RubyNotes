<% page_title 'All Notes' %>
<% breadcrumb ['Administration'], ['All Notes'] %>

<%= render 'shared/page_header',
      title: 'All Notes',
      subtitle: 'Manage all notes across the platform',
      actions: capture {
        link_to new_note_path, class: 'btn btn-primary' do
          safe_join([icon('plus'), ' New Note'])
        end
      } %>

<div class="search-wrapper">
  <%= render 'shared/search_input', placeholder: 'Search notes by title...' %>
</div>

<% if @notes.any? %>
  <div class="grid-cards">
    <% @notes.each do |note| %>
      <%= render 'notes/note_card', note: note %>
    <% end %>
  </div>

  <%= render 'shared/pagination' %>
<% elsif searching? %>
  <%= render 'shared/empty_state',
        icon: 'magnifying-glass', icon_style: :solid,
        title: "No notes match “#{search_query}”",
        description: 'Try a different search term.',
        action_path: notes_path,
        action_icon: 'times',
        action_label: 'Clear search' %>
<% else %>
  <%= render 'shared/empty_state',
        icon: 'sticky-note',
        title: 'No notes found',
        description: 'No notes have been created yet.' %>
<% end %>
