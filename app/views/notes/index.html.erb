<%= render 'layouts/navbar' %>

<% if @notes.any? %>
  <div class="container mt-5">
    <hr class="border border-dark" style="height: 8px; background-color: black; margin-bottom: 3rem">
    <div data-controller="search" data-search-match-on-value=".card-title">
      <form class="d-flex mb-2">
        <input class="form-control me-2" type="search" placeholder="Search by title" aria-label="Search" data-search-target="input" data-action="input->search#filter">
      </form>
      <div class="row" data-search-target="list">
        <% @notes.each do |note| %>
          <div class="col-md-4 mb-4 note" data-search-target="item">
            <div class="card bg-color-card">
              <div class="card-body">
                <h5 class="card-title"><%= note.title %></h5>
                <hr class="my-4 border border-dark">
                <div class="card-text note-content">
                  <% if note.content.present? %>
                    <div style="max-width: 500px; max-height: 500px; overflow: auto;">
                      <%= sanitize(note.content) %>
                    </div>
                  <% end %>
                </div>
              </div>
              <div class="card-footer d-flex align-items-center gap-2">
                <%= link_to note, class: 'btn btn-primary mr-2' do %>
                  <i class="fas fa-eye"></i> Show
                <% end %>
                <%= link_to edit_note_path(note), class: 'btn btn-secondary' do %>
                  <i class="fas fa-edit"></i> Edit
                <% end %>
                <%= link_to edit_note_path(note), class: 'btn btn-primary mr-2' do %>
                  <i class="fas fa-plus"></i> Add to Collection
                <% end %>
                <%= button_to note_path(note), method: :delete, class: 'btn btn-danger', data: { confirm: 'Are you sure?' } do %>
                  <i class="fas fa-trash-alt"></i> Delete
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% else %>
  <div class="container text-center mt-5">
    <p style="font-size: 48px;"><i class="far fa-frown"></i> You don't have any notes! <i class="far fa-frown"></i></p>
    <hr class="border border-dark mt-5" style="height: 8px; background-color: black; margin-bottom: 3rem">
    <%= link_to new_note_path, class: 'btn btn-success btn-lg' do %>
      <i class="fas fa-pencil-alt"></i> Start now!
    <% end %>
  </div>
<% end %>
