<% page_title 'All Users' %>
<% breadcrumb ['Administration'], ['All Users'] %>

<%= render 'shared/page_header',
      title: 'All Users',
      subtitle: 'Manage registered users',
      actions: capture {
        link_to new_user_path, class: 'btn btn-primary' do
          safe_join([icon('user-plus'), ' New User'])
        end
      } %>

<div class="search-wrapper">
  <%= render 'shared/search_input', placeholder: 'Search users by name...' %>
</div>

<% if @users.any? %>
  <div class="grid-cards">
    <% @users.each do |user| %>
      <%= render 'users/user_card', user: user %>
    <% end %>
  </div>

  <%= render 'shared/pagination' %>
<% elsif searching? %>
  <%= render 'shared/empty_state',
        icon: 'magnifying-glass', icon_style: :solid,
        title: "No users match “#{search_query}”",
        description: 'Try a different name.',
        action_path: users_path,
        action_icon: 'times',
        action_label: 'Clear search' %>
<% else %>
  <%= render 'shared/empty_state',
        icon: 'users', icon_style: :solid,
        title: 'No users found',
        description: 'No users are registered yet.' %>
<% end %>
