<%# Shared by the public sign-up card and the admin "New User" form. %>
<div class="form-group">
  <%= form.label :name, 'Username', class: 'form-label' %>
  <%= form.text_field :name, class: 'form-control', required: true,
        autofocus: local_assigns.fetch(:autofocus, true), autocomplete: 'username' %>
</div>

<div class="form-group">
  <%= form.label :password, 'Password', class: 'form-label' %>
  <%= form.password_field :password, class: 'form-control', required: true,
        autocomplete: 'new-password', 'aria-describedby': 'password-hint' %>
  <p class="form-hint" id="password-hint">Use at least 8 characters.</p>
</div>

<div class="form-group">
  <%= form.label :password_confirmation, 'Confirm password', class: 'form-label' %>
  <%= form.password_field :password_confirmation, class: 'form-control', required: true,
        autocomplete: 'new-password' %>
</div>

<% if current_user&.admin? %>
  <div class="form-group">
    <%= form.label :role, 'Role', class: 'form-label' %>
    <%= form.select :role, options_for_select([['User', 'user'], ['Admin', 'admin']], 'user'), {},
          class: 'form-select' %>
  </div>
<% end %>
