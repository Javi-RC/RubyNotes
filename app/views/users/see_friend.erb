<%= render 'layouts/navbar' %>

<div class="container mt-5">
  <div class="card shadow-sm">
    <div class="card-header">
      <h5 class="card-title mb-0">Friend Details</h5>
    </div>
    <div class="card-body">
      <h3>Name:</h3>
      <p><%= sanitize(@friend.name) %></p>

      <% if @friend.role.present? %>
        <h3>Role:</h3>
        <p><%= @friend.role %></p>
      <% end %>

      <h2>Notes:</h2>
      <div class="row">
        <% if @notes.present? %>
          <% @notes.each do |note| %>
            <div class="col-md-4 mb-4">
              <div class="card bg-color-card">
                <div class="card-body">
                  <h5 class="card-title"><%= note.title %></h5>
                  <hr class="my-4 border border-dark">
                  <div class="card-text note-content">
                    <% if note.content.present? %>
                      <div style="max-width: 500px; max-height: 500px; overflow: auto;">
                        <%= sanitize(note.content) %>
                      </div>
                    <% end %>
                  </div>
                </div>
                <div class="card-footer">
                  <%= link_to note, class: 'btn btn-primary mr-2' do %>
                    <i class="fas fa-eye"></i> Show
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        <% else %>
          <p>This friend don't have any note shared with you!</p>
        <% end %>
      </div>

      <h2>Collections:</h2>
      <div class="row">
        <% if @collections.present? %>
          <% @collections.each do |collection| %>
            <div class="col-md-4 mb-4">
              <div class="card bg-color-card">
                <div class="card-body">
                  <h5 class="card-title"><%= collection.title %></h5>
                  <hr class="my-4 border border-dark">
                  <div class="card-text collection-notes">
                    <% if collection.notes.any? %>
                      <% collection.notes.each do |note| %>
                        <p><%= truncate(sanitize(note.title), length: 50) %></p>
                      <% end %>
                    <% else %>
                      <p>No notes in this collection yet.</p>
                    <% end %>
                  </div>
                </div>
                <div class="card-footer">
                  <%= link_to collection, class: 'btn btn-primary mr-2' do %>
                    <i class="fas fa-eye"></i> Show
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        <% else %>
          <p>This friend don't have any collection!</p>
        <% end %>
      </div>
    </div>

    <div class="card-footer d-flex align-items-center gap-2">
      <%= link_to friends_path, class: 'back-button my-2' do %>
        <i class="fas fa-arrow-left"></i> Back
      <% end %>
    </div>
  </div>
</div>
