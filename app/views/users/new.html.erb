<nav class="navbar navbar-expand-lg navbar-light bg-color" style="padding: 20px 0; margin-bottom: 5rem;">
  <div class="container">
    <% if not session[:user].present? %>
    <a class="navbar-brand nav-text" href="/"><i class="fas fa-home"></i> Welcome Page!</a>
    <% else %>
    <a class="navbar-brand nav-text" href="/users"><i class="fas fa-users"></i> Users List!</a>
    <% end %>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <% if not session[:user].present? %>
    <% else %>
    <ul class="navbar-nav ms-auto nav-text"> 
        <%= form_tag '/logout', method: :delete do %>
          <%= button_tag type: 'submit', class: 'nav-link btn btn-outline-dark' do %>
            <i class="fa-solid fa-right-from-bracket"></i> LogOut
          <% end %>
        <% end %>
      </ul>
      <% end %>
  </div>
</nav>

<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="container">
        <div class="card">
          <div class="card-body">
            <h2 class="card-title text-center mb-4 mt-4"><i class="fas fa-user-plus"></i> Register</h2>
            <hr class="border border-dark" style="height: 8px; background-color: black; margin-bottom: 3rem">
            <%= form_with(model: @user, url: users_path, method: :post) do |form| %>
              <% if @user.errors.any? %>
                <div class="alert alert-danger">
                  <ul>
                    <% @user.errors.full_messages.each do |msg| %>
                      <li><%= msg %></li>
                    <% end %>
                  </ul>
                </div>
              <% end %>
              <div class="form-group">
                <%= form.label :name %>
                <%= form.text_field :name, class: "form-control", required: true %>
              </div>
              <div class="form-group">
                <%= form.label :password %>
                <%= form.password_field :password, class: "form-control", required: true %>
              </div>
              <div class="form-group">
                <%= form.label :password_confirmation %>
                <%= form.password_field :password_confirmation, class: "form-control", required: true %>
              </div>
              <% if session[:user].present? && User.find_by(name: session[:user]).role === 'admin' %>
                <div class="form-group">
                  <%= form.label :role %>
                  <%= form.select :role, options_for_select([['User', 'user'], ['Admin', 'admin']], 'user'), { prompt: 'Select Role' }, class: 'form-control' %>
                </div>
              <% end %>
              <div class="text-center">
                <% if session[:user].present? %>
                  <%= form.submit "Create User!", class: "btn btn-primary btn-block mt-4" %>
                <% else %>
                  <%= form.submit "Register", class: "btn btn-primary btn-block mt-4" %>
                <% end %>
              </div>
            <% end %>
            <% unless session[:user].present? %>
              <div class="text-center mt-3">
                <p>Do you have an account? 👇</p> 
                <%= link_to "Log in", new_session_path %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
