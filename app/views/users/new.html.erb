<% if current_user %>
  <%# Admin creating a user: render inside the app shell, not as an auth card. %>
  <% page_title 'New User' %>
  <% breadcrumb ['Administration'], ['All Users', users_path], ['New User'] %>

  <%= render 'shared/back_link', label: 'Back to users', back_path: users_path %>

  <%= render layout: 'shared/form_card', locals: { title: 'New User', object: @user } do %>
    <%= form_with(model: @user, url: users_path, method: :post) do |form| %>
      <%= render 'users/form_fields', form: form %>
      <div class="form-actions">
        <%= form.submit 'Create User', class: 'btn btn-primary btn-lg' %>
        <%= link_to 'Cancel', users_path, class: 'btn btn-ghost' %>
      </div>
    <% end %>
  <% end %>
<% else %>
  <% page_title 'Create account' %>

  <div class="auth-card">
    <div class="auth-card__brand">
      <%= icon 'user-plus' %>
      <h1>Create account</h1>
      <p>Get started with RubyNotes</p>
    </div>

    <%= render 'shared/form_errors', object: @user %>

    <%= form_with(model: @user, url: users_path, method: :post) do |form| %>
      <%= render 'users/form_fields', form: form %>
      <%= form.submit 'Create Account', class: 'btn btn-primary btn-lg' %>
    <% end %>

    <div class="auth-card__footer">
      Already have an account? <%= link_to 'Sign in', new_session_path %>
    </div>

    <div class="auth-card__home-link">
      <%= link_to root_path do %>
        <%= icon 'arrow-left' %> Back to home
      <% end %>
    </div>
  </div>
<% end %>
