<% page_title @user.name %>
<% breadcrumb ['Administration'], ['All Users', users_path], [@user.name] %>

<%= render 'shared/back_link', label: 'Back to users', back_path: users_path %>

<%= render layout: 'shared/detail_card', locals: {
      title: @user.name,
      heading: capture { render 'users/profile_heading', user: @user },
      actions: capture {
        safe_join([
          link_to(edit_user_path(@user), class: 'btn btn-sm btn-secondary') { safe_join([icon('pen'), ' Edit']) },
          (unless @user == current_user
            button_to(user_path(@user), method: :delete, class: 'btn btn-sm btn-danger',
                      form: { data: { turbo_confirm: "Delete #{@user.name}? Their notes and collections will be transferred or removed. This cannot be undone." } }) {
              safe_join([icon('trash-can', style: :regular), ' Delete'])
            }
          end)
        ].compact)
      }
    } do %>

  <% if @user.notes.any? %>
    <h3 class="section-heading">Notes</h3>
    <div class="grid-cards mb-6">
      <% @user.notes.each do |note| %>
        <%= render 'notes/note_card', note: note %>
      <% end %>
    </div>
  <% end %>

  <% if @user.collections.any? %>
    <h3 class="section-heading">Collections</h3>
    <div class="grid-cards">
      <% @user.collections.each do |collection| %>
        <%= render 'collections/collection_card', collection: collection %>
      <% end %>
    </div>
  <% end %>

  <% if @user.notes.empty? && @user.collections.empty? %>
    <%= render 'shared/empty_state', variant: :inline,
          icon: 'folder-open', title: 'This user has no content yet.' %>
  <% end %>
<% end %>
