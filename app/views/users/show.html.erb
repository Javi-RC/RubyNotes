<nav class="navbar navbar-expand-lg navbar-light bg-color" style="padding: 20px 0; margin-bottom: 5rem;">
  <div class="container">
    <% if not session[:user].present? %>
    <a class="navbar-brand nav-text" href="/"><i class="fas fa-home"></i> Welcome Page!</a>
    <% else %>
      <a class="navbar-brand nav-text" href="/users"><i class="fas fa-users"></i> Users List!</a>
    <% end %>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <ul class="navbar-nav ms-auto nav-text"> 
        <%= form_tag '/logout', method: :delete do %>
          <%= button_tag type: 'submit', class: 'nav-link btn btn-outline-dark' do %>
            <i class="fa-solid fa-right-from-bracket"></i> LogOut
          <% end %>
        <% end %>
      </ul>
  </div>
</nav>
<div class="container mt-5">
  <div class="card shadow-sm">
    <div class="card-header">
      <h5 class="card-title mb-0">User Details</h5>
    </div>
    <div class="card-body">
      <h3>Name:</h3>
      <p><%= @user.name %></p>
      
      <% if @user.role.present? %>
        <h3>Role:</h3>
        <p><%= @user.role %></p>
      <% end %>

      <h2>Notes:</h2>
      <div class="row">
        <% if @user.notes.present? %>
          <% @user.notes.each do |note| %>
            <div class="col-md-4 mb-4">
              <div class="card bg-color-card">
                <div class="card-body">
                  <h5 class="card-title"><%= note.title %></h5>
                  <hr class="my-4 border border-dark">
                  <div class="card-text note-content">
                    <% if note.content.present? %>
                      <div style="max-width: 500px; max-height: 500px; overflow: auto;">
                        <%= raw(note.content.html_safe) %>
                      </div>
                    <% end %>
                  </div>
                </div>
                <div class="card-footer">
                  <%= link_to note, class: 'btn btn-primary mr-2' do %>
                    <i class="fas fa-eye"></i> Show
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        <% else %>
          <p>This user don't have any note!</p>
        <% end %>
      </div>
      
      <h2>Collections:</h2>
      <div class="row">
        <% if @user.collections.present? %>
          <% @user.collections.each do |collection| %>
            <div class="col-md-4 mb-4">
              <div class="card bg-color-card">
                <div class="card-body">
                  <h5 class="card-title"><%= collection.title %></h5>
                  <hr class="my-4 border border-dark">
                  <div class="card-text collection-notes">
                <% if collection.notes.any? %>
                  <% collection.notes.each do |note| %>
                    <p><%= truncate(raw(note.title), length: 50) %></p>
                  <% end %>
                <% else %>
                  <p>No notes in this collection yet.</p>
                <% end %>
              </div>
                </div>
                <div class="card-footer">
                  <%= link_to collection, class: 'btn btn-primary mr-2' do %>
                    <i class="fas fa-eye"></i> Show
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        <% else %>
          <p>This user don't have any collection!</p>
        <% end %>
      </div>
    </div>
  
    <div class="card-footer d-flex align-items-center gap-2">
      <%= link_to users_path, class: 'back-button my-2' do %>
        <i class="fas fa-arrow-left"></i> Back
      <% end %>
      <%= link_to edit_user_path(@user), class: 'btn btn-secondary' do %>
        <i class="fas fa-edit"></i> Edit
      <% end %>
      <%= button_to user_path(@user), method: :delete, class: 'btn btn-danger', data: { confirm: 'Are you sure?' } do %>
        <i class="fas fa-trash-alt"></i> Delete
      <% end %>
    </div>
  </div>
</div>
