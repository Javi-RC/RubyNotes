


<div class="container mt-5">
  <div class="card shadow-sm">
    <div class="card-header">
      <h5 class="card-title mb-0">User Details</h5>
    </div>
    <div class="card-body">

      <%= form_with(model: @user, local: true) do |form| %>
            <% if @user.errors.any? %>
  <div class="alert alert-danger">
    <ul>
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

        <div class="mb-3">
          <%= form.label :name, class: 'form-label' %>
          <%= form.text_field :name, class: 'form-control' %>
        </div>
      <div class="mb-3">
        <%= form.label :password, class: 'form-label' %>
        <%= form.password_field :password, class: 'form-control' %>
      </div>
      <% if User.find_by(name: session[:user]).role === 'admin' %>
      <div class="mb-3">
        <%= form.label :role, class: 'form-label' %>
        <%= form.select :role, options_for_select(['user', 'admin'], @user.role), {}, class: 'form-control' %>
      </div>
      <% end %>

        <h2>Notes:</h2>
        <div class="row">
          <% if @user.notes.present? %>
            <% @user.notes.each do |note| %>
              <div class="col-md-4 mb-4">
                <div class="card bg-color-card">
                  <div class="card-body">
                    <h5 class="card-title"><%= note.title %></h5>
                    <hr class="my-4 border border-dark">
                    <div style="max-width: 500px; max-height: 500px; overflow: auto;">
                      <%= raw(note.content.html_safe) %>
                    </div>
                  </div>
                  <div class="card-footer">
                    <%= link_to note, class: 'btn btn-primary mr-2' do %>
                      <i class="fas fa-eye"></i> Show
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          <% else %>
            <p>This user doesn't have any notes!</p>
          <% end %>
        </div>
        <div class="row">
          <div class="col-md-6">
            <%= link_to "New Note", new_user_note_path(@user), class: 'btn btn-primary mb-3' %>
          </div>

        <h2>Collections:</h2>
        <div class="row">
          <% if @user.collections.present? %>
            <% @user.collections.each do |collection| %>
              <div class="col-md-4 mb-4">
                <div class="card bg-color-card">
                  <div class="card-body">
                    <h5 class="card-title"><%= collection.title %></h5>
                    <hr class="my-4 border border-dark">
                    <div class="card-text collection-notes">
                      <% if collection.notes.any? %>
                        <% collection.notes.each do |note| %>
                          <p><%= truncate(raw(note.title), length: 50) %></p>
                        <% end %>
                      <% else %>
                        <p>No notes in this collection yet.</p>
                      <% end %>
                    </div>
                  </div>
                  <div class="card-footer">
                    <%= link_to collection, class: 'btn btn-primary mr-2' do %>
                      <i class="fas fa-eye"></i> Show
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          <% else %>
            <p>This user doesn't have any collections!</p>
          <% end %>
          </div>
          <div class="col-md-6">
            <%= link_to "New Collection", new_user_collection_path(@user), class: 'btn btn-primary mb-3 mr-2' %>
          </div>
        </div>

        <div class="d-flex align-items-center gap-2">
          <%= link_to @myroute, class: 'back-button my-2' do %>
            <i class="fas fa-arrow-left"></i> Back
          <% end %>
          <%= form.submit 'Update', class: 'btn btn-primary' %>
          <%= link_to 'Delete', user_path(@user), method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-danger' %>
        </div>
      <% end %>
    </div>
  </div>
</div>
