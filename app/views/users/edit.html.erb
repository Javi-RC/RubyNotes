<% own_profile = current_user == @user %>
<% page_title own_profile ? 'Edit profile' : 'Edit User' %>
<% if own_profile %>
  <% breadcrumb ['Profile', show_profile_path(@user)], ['Edit'] %>
<% else %>
  <% breadcrumb ['Administration'], ['All Users', users_path], [@user.name, @user], ['Edit'] %>
<% end %>

<%= render 'shared/back_link',
      label: own_profile ? 'Back to profile' : 'Back to user',
      back_path: own_profile ? show_profile_path(@user) : user_path(@user) %>

<%= render layout: 'shared/form_card', locals: {
      title: own_profile ? 'Edit profile' : "Edit: #{@user.name}",
      object: @user
    } do %>
  <%= form_with(model: @user, local: true) do |form| %>
    <div class="form-group">
      <%= form.label :name, 'Username', class: 'form-label' %>
      <%= form.text_field :name, class: 'form-control', required: true, autocomplete: 'username' %>
    </div>

    <div class="form-group">
      <%= form.label :password, 'New password', class: 'form-label' %>
      <%= form.password_field :password, class: 'form-control', autocomplete: 'new-password',
            'aria-describedby': 'new-password-hint' %>
      <p class="form-hint" id="new-password-hint">Leave blank to keep the current password.</p>
    </div>

    <% if current_user&.admin? %>
      <div class="form-group">
        <%= form.label :role, 'Role', class: 'form-label' %>
        <%= form.select :role, options_for_select([['User', 'user'], ['Admin', 'admin']], @user.role), {},
              class: 'form-select' %>
      </div>
    <% end %>

    <div class="form-actions">
      <%= form.submit 'Save Changes', class: 'btn btn-primary btn-lg' %>
      <%= link_to 'Cancel', own_profile ? show_profile_path(@user) : user_path(@user), class: 'btn btn-ghost' %>
    </div>
  <% end %>
<% end %>

<section class="section-block" aria-labelledby="user-notes-heading">
  <div class="page-header">
    <div class="page-header__left">
      <h2 class="section-title" id="user-notes-heading">
        <%= own_profile ? 'Your notes' : "#{@user.name}'s notes" %>
      </h2>
    </div>
    <div class="page-header__actions">
      <%= link_to new_user_note_path(@user), class: 'btn btn-secondary btn-sm' do %>
        <%= icon 'plus' %> New Note
      <% end %>
    </div>
  </div>

  <% if @user.notes.any? %>
    <div class="grid-cards">
      <% @user.notes.each do |note| %>
        <%= render 'notes/note_card', note: note %>
      <% end %>
    </div>
  <% else %>
    <%= render 'shared/empty_state', variant: :inline,
          icon: 'sticky-note', title: 'No notes yet.' %>
  <% end %>
</section>

<section class="section-block" aria-labelledby="user-collections-heading">
  <div class="page-header">
    <div class="page-header__left">
      <h2 class="section-title" id="user-collections-heading">
        <%= own_profile ? 'Your collections' : "#{@user.name}'s collections" %>
      </h2>
    </div>
    <div class="page-header__actions">
      <%= link_to new_user_collection_path(@user), class: 'btn btn-secondary btn-sm' do %>
        <%= icon 'plus' %> New Collection
      <% end %>
    </div>
  </div>

  <% if @user.collections.any? %>
    <div class="grid-cards">
      <% @user.collections.each do |collection| %>
        <%= render 'collections/collection_card', collection: collection %>
      <% end %>
    </div>
  <% else %>
    <%= render 'shared/empty_state', variant: :inline,
          icon: 'folder', title: 'No collections yet.' %>
  <% end %>
</section>
