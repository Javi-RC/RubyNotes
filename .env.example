# Copy to .env and fill in. .env is gitignored; never commit real credentials.

# MongoDB connection string used by development and production.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.XXXXX.mongodb.net/NoteBranch?retryWrites=true&w=majority&appName=Cluster0

# Database used by the test suite. Must NOT be the development cluster:
# the suite calls Mongoid.purge! between tests.
MONGODB_TEST_URI=mongodb://localhost:27017/rubynotes_test

TINYMCE_API_KEY=your_tinymce_api_key_here
SECRET_KEY_BASE=your_secret_key_base_here
RAILS_ENV=development
